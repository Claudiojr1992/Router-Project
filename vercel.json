{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "vercel-static",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,src,db}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/geocodificar",
      "schedule": "0 9 * * *"
    }
  ]
}
