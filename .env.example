# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Ambiente
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Banco PostgreSQL
# Local (docker compose): postgres://routproject:routproject@db:5432/routproject
# AWS RDS: postgres://USUARIO:SENHA@ENDPOINT-DO-RDS:5432/routproject
DATABASE_URL=postgres://routproject:routproject@localhost:5432/routproject
# true na AWS (o RDS exige conexão criptografada)
DB_SSL=false
# Opcional: caminho do certificado do RDS (global-bundle.pem) para validar a conexão
DB_SSL_CA=
# No container Docker o certificado já vem em /app/certs/rds-global-bundle.pem

# Cookie de sessão só por HTTPS (padrão: automático pelo APP_URL)
# COOKIE_SECURE=true
# Proxies na frente do app: 1 = instância única (nginx); 2 = com load balancer
TRUST_PROXY_HOPS=1

# Sessão: troque por um texto longo e aleatório (ex.: openssl rand -hex 32)
SESSION_SECRET=troque-este-valor-por-um-segredo-longo
# Duração da sessão em horas (técnicos que ficam dias sem sinal: 168)
SESSION_HOURS=12

# Primeiro acesso: cria o administrador na primeira subida, se ainda não existir
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Carga inicial do cliente BNB (contratos, 97 endereços, atividades e checklists)
SEED_BNB=true

# E-mail (códigos de confirmação e de recuperação de senha)
# Sem SMTP_HOST, os códigos aparecem no log do servidor.
# Na AWS use o Amazon SES (host email-smtp.sa-east-1.amazonaws.com, porta 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RoutProject <nao-responda@seudominio.com.br>

# Docker Compose: monta a imagem sem o "bake" (evita o pedido de --allow=fs.read quando a pasta é um atalho/symlink)
COMPOSE_BAKE=false
